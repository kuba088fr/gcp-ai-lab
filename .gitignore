# --- Terraform ---
# Provider plugins downloaded by `terraform init`
.terraform/
# Local state: contains resource details and may contain secrets
*.tfstate
*.tfstate.*
# Variable files may contain project-specific or sensitive values
*.tfvars
*.tfvars.json
crash.log
crash.*.log
# Note: .terraform.lock.hcl is intentionally NOT ignored (pins provider versions)

# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Secrets ---
.env
.env.*
*.json.key
*-key.json

# --- Test data (PDFs etc.) ---
labs/*/data/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
